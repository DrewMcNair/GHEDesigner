{
  "version": 3.0,
  "description": "Simple example system",
  "topology_elements": [
    { "id": "div1", "type": "diverging_junction" },
    { "id": "mer1", "type": "merging_junction" },
    { "id": "div2", "type": "diverging_junction" },
    { "id": "mer2", "type": "merging_junction" },
    { "id": "hp1", "type": "heat_pump" },
    { "id": "hp2", "type": "heat_pump" }
  ],
  "simulate_horizontal_effects": true,
  "horizontal_discretization_level": 3,
  "default_pipe_diameter": 0.04,
  "pipes": [
    {
      "id": "main_supply",
      "from": "div1",
      "to": "div2",
      "diameter": 0.06,
      "trench_id": "t1"
    },
    {
      "id": "main_return",
      "from": "mer1",
      "to": "mer2",
      "diameter": 0.06,
      "trench_id": "t1"
    },
    {
      "id": "hp1_supply",
      "from": "div1",
      "to": "hp1",
      "trench_id": "t2"
    },
    {
      "id": "hp1_return",
      "from": "hp1",
      "to": "mer1",
      "trench_id": "t2"
    },
    {
      "id": "hp2_supply",
      "from": "div2",
      "to": "hp2",
      "trench_id": "t3"
    },
    {
      "id": "hp2_return",
      "from": "hp2",
      "to": "mer2",
      "trench_id": "t3"
    }
  ],
  "trenches": {
    "spacing": 0.25,
    "depth": 1.5,
    "soil": {
      "conductivity": 2,
      "rho_cp": 2343493,
      "undisturbed_temp": 6.1
    }
  },
  "comment2": "the rest of the file continues the same as Dr. Mitchell's JSON,",
  "comment3": "defining the properties of all components"
}
